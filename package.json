{
  "name": "distributed-webhook-dlq",
  "version": "0.1.0",
  "private": true,
  "description": "Distributed webhook delivery system with retry logic and dead letter queue",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "worker": "tsx watch src/worker/run.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test src/**/*.test.ts"
  },
  "dependencies": {
    "bullmq": "^6.0.9",
    "express": "^4.19.2",
    "ioredis": "^6.0.0",
    "ipaddr.js": "^2.5.0",
    "undici": "^6.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0"
  }
}
