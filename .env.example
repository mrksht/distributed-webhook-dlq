# Required. A JSON object mapping each project's API key to its tenant id. No default -- the
# server fails closed (rejects every request) if this is unset, empty, malformed, or not a JSON
# object. Generate each key with, e.g.: openssl rand -hex 32
# Example: API_KEYS={"<key-for-project-a>":"project-a","<key-for-project-b>":"project-b"}
API_KEYS=

# Optional -- these already have safe defaults (127.0.0.1:6379), only needed to override.
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
